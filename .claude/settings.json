{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-rm-rf.py\"",
            "timeout": 30,
            "statusMessage": "Checking rm -rf targets"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-tidy.py\"",
            "timeout": 300,
            "statusMessage": "Running clang-format and clang-tidy on changed files"
          }
        ]
      }
    ]
  }
}
